class_name VoiceBank
extends RefCounted
## Phase 18: the runtime voice index (data/voice/index.json, generated by
## tools/voice/build_voices.py). Clips live at
## res://audio/voice/<profile>/<line_id>.ogg; nothing is generated in play.
## The index (duration, delivery, 20 Hz mouth envelope) loads lazily once;
## audio streams load on demand when a line is spoken (bounded cache in
## Godot's resource loader), never the whole bank up front.

const INDEX := "res://data/voice/index.json"
const DB := {"calm": -4.0, "effort": -2.5, "uneasy": -5.0, "frightened": -3.0, "whisper": -13.0}

static var _clips := {}
static var _loaded := false


static func _load() -> void:
	if _loaded:
		return
	_loaded = true
	var d: Variant = JSON.parse_string(FileAccess.get_file_as_string(INDEX)) if FileAccess.file_exists(INDEX) else null
	if typeof(d) == TYPE_DICTIONARY:
		_clips = (d as Dictionary).get("clips", {})


static func key(profile: String, line_id: String) -> String:
	return "%s/%s" % [profile, line_id]


static func has(profile: String, line_id: String) -> bool:
	_load()
	return _clips.has(key(profile, line_id)) and ResourceLoader.exists(path(profile, line_id))


static func path(profile: String, line_id: String) -> String:
	return "res://audio/voice/%s/%s.ogg" % [profile, line_id]


static func info(profile: String, line_id: String) -> Dictionary:
	_load()
	var c: Array = _clips.get(key(profile, line_id), [])
	if c.is_empty():
		return {}
	return {"duration": float(c[0]), "delivery": str(c[1]), "envelope": str(c[2])}


static func count() -> int:
	_load()
	return _clips.size()
