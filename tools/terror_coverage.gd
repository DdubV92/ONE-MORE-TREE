extends Node
## Phase 6 coverage runner (headless). Executes EVERY authored ordinary
## event (26 x 50) and startle type (26 x 12) once, in its own context, in a
## Preview world with the two starting workers, a pickup and the dog:
## reserve -> establish -> hold/react -> (peak) -> withdraw -> cleanup.
## Records RuntimeObserved / QuietNoPlace / Error per id and writes
## docs/coverage/phase6_coverage.json + .md. The T26 family is the
## once-only rescue quest and is covered by tools/hunt_sim.tscn instead.
##   godot --headless res://tools/terror_coverage.tscn

const CTX_SPOT := {"woods": "forest", "camp": "camp", "cabin": "cabin", "camper": "camper", "cameras": "camper_lounge"}

func _ready() -> void:
	Game.mode = Game.Mode.PREVIEW
	Game.pending_teleport = "camp"
	var w: IslandWorld = load("res://scenes/world.tscn").instantiate()
	w.build_ui = false
	add_child(w)
	var g := 0
	while not w.systems_ready and g < 900:
		await get_tree().physics_frame
		g += 1
	w.campaign.start_test_route(false)
	w.campaign.wallet.grant(2000000, "test", "COV", "coverage fixture")
	w.vehicles.dev_unlock = true
	w.vehicles.buy()
	w.environment.apply_named("night")
	w.tv.force_active = true
	var dir: TerrorDirector = w.director
	var p: Player = w.player
	var results := {}
	var per_family := {}
	var only := OS.get_environment("COV_ONLY")
	var all: Array = []
	all.append_array(dir.bank.events)
	all.append_array(dir.bank.startles)
	var t0 := Time.get_ticks_msec()
	var current_ctx := ""
	for ev in all:
		var id := str(ev.id)
		if only != "" and not id.begins_with(only):
			continue
		var fam := int(ev.family)
		if not per_family.has(fam):
			per_family[fam] = {"events": 0, "observed": 0, "quiet": 0, "error": 0, "rescue": 0, "startles": 0, "startles_observed": 0}
		var pf: Dictionary = per_family[fam]
		var is_startle := id.contains("-J")
		if is_startle:
			pf.startles = int(pf.startles) + 1
		else:
			pf.events = int(pf.events) + 1
		if "rescue_beat" in str(ev.steps):
			results[id] = "rescue_quest"
			pf.rescue = int(pf.rescue) + 1
			continue
		var ctx := str(ev.get("context", "woods"))
		if ctx == "interior":
			ctx = "camper"
		if ctx != current_ctx:
			current_ctx = ctx
			if p.couch:
				p.stand_from_couch()
			w.teleport_to(CTX_SPOT[ctx])
			for i in 6:
				await get_tree().physics_frame
			if ctx == "cameras":
				p.sit_on_couch(get_tree().get_nodes_in_group("couch_seat")[0])
				for i in 30:
					await get_tree().process_frame
		var errs0 := Diag.errors.size()
		dir.last_peak_t = -99999.0     # each startle gets its own peak budget here
		var id_started := dir._start(ev, ctx, p, true)
		if id_started == "":
			results[id] = "quiet_no_place"
			pf.quiet = int(pf.quiet) + 1
			continue
		var enc := dir.active
		var steps := 0
		while is_instance_valid(enc) and enc.stage != "done" and steps < 160:
			enc._process(0.5)
			if enc.actor and is_instance_valid(enc.actor):
				enc.actor._process(0.5)
			steps += 1
		if is_instance_valid(enc) and enc.stage != "done":
			enc.finish("timeout")
		await get_tree().process_frame
		var errs := Diag.errors.size() - errs0
		var res := str(dir.observed.get(id, "?"))
		if errs > 0:
			results[id] = "error"
			pf.error = int(pf.error) + 1
			print("ERR ", id, " ", Diag.errors.slice(errs0))
		else:
			results[id] = res
			if is_startle:
				pf.startles_observed = int(pf.startles_observed) + 1
			else:
				pf.observed = int(pf.observed) + 1
		dir.active = null
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://docs/coverage"))
	var counts := {}
	for k in results:
		counts[results[k]] = int(counts.get(results[k], 0)) + 1
	var out := {"generated_ms": Time.get_ticks_msec() - t0, "counts": counts, "per_family": per_family, "results": results, "foreman_patterns": dir.bank.foreman.size()}
	if only == "":
		var f := FileAccess.open("res://docs/coverage/phase6_coverage.json", FileAccess.WRITE)
		f.store_string(JSON.stringify(out, "\t"))
		f.close()
		var md := PackedStringArray(["# Phase 6 ordinary-event coverage (generated)", "", "Generated by `tools/terror_coverage.tscn` (headless, Preview fixture: two workers, one pickup, the dog, night lighting). Each id was executed once in its own context through the real director/encounter code. *RuntimeObserved* = it reserved a grounded place, ran its plan to cleanup without script errors. *Quiet* = no valid place in that fixture (a legal outcome). Visual/audio quality is NOT judged by this run.", "", "| Family | Events (of 50) | Observed | Quiet | Errors | Rescue-quest beats | Startles (of 12) | Startles observed |", "|---|---|---|---|---|---|---|---|"])
		for fam_i in range(1, 27):
			var fx: Dictionary = per_family.get(fam_i, {})
			var name_: String = str(dir.bank.families[fam_i - 1].name)
			md.append("| T%02d %s | %d | %d | %d | %d | %d | %d | %d |" % [fam_i, name_, int(fx.get("events", 0)), int(fx.get("observed", 0)), int(fx.get("quiet", 0)), int(fx.get("error", 0)), int(fx.get("rescue", 0)), int(fx.get("startles", 0)), int(fx.get("startles_observed", 0))])
		md.append("")
		md.append("Totals: %s" % JSON.stringify(counts))
		var f2 := FileAccess.open("res://docs/coverage/phase6_coverage.md", FileAccess.WRITE)
		f2.store_string("\n".join(md) + "\n")
		f2.close()
	print("COVERAGE ", JSON.stringify(counts), " in ", out.generated_ms, " ms")
	get_tree().quit()
