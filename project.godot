[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=4096
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.85, 1)
textures/default_filters/anisotropic_filtering_level=3
shader_compiler/shader_cache/enabled=true

[shader_globals]

wind_dir={"type": "vec2", "value": Vector2(0.8, 0.6)}
wind_strength={"type": "float", "value": 0.5}
world_time={"type": "float", "value": 0.0}
sea_level={"type": "float", "value": 0.0}
sun_dir_world={"type": "vec3", "value": Vector3(0.3, 0.8, 0.3)}
daylight={"type": "float", "value": 1.0}
haze_strength={"type": "float", "value": 1.0}
