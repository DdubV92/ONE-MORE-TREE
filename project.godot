; Engine configuration file.
; Pinned engine: Godot 4.5.1-stable (see docs/ARCHITECTURE.md before changing).

config_version=5

[application]

config/name="One More Tree"
config/description="A first-person cozy logging game on a finite island."
config/version="0.0.1-phase0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/bg_color=Color(0.06, 0.08, 0.07, 1)
boot_splash/show_image=false

[autoload]

Settings="*res://scripts/core/settings.gd"
Diag="*res://scripts/core/diagnostics.gd"
Game="*res://scripts/core/game.gd"
World="*res://scripts/world/world_data.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

